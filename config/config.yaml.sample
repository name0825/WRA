ollama:
  base_url: "http://localhost:11434"

# Multiple models may be configured for each role.
# Each entry may be a model name string or an object with per-model options.
# think: true/false enables/disables Ollama reasoning when supported by the model.
# timeout: request timeout in seconds. Omit it to use the Ollama client default.
models:
  analyzer:
    - name: "gemma4:26b"
  designer:
    - name: "gemma4:26b"
  generator: 
    - name: "gemma4:12b"

  # Model that edits a finished page during a refinement pass. Left empty it
  # falls back to the generator pool, where a small model damages the source
  # text as often as it improves the design. Use designer-grade models here.
  refiner:
    - name: "gemma4:26b"

  # Vision model used to read the source images and the source page screenshot.
  # Leave empty to skip media vision entirely.
  vision:
    - name: "gemma4:26b"
      timeout: 900

# Where the source site comes from and how much of it is redesigned.
#   entry : redesign the entry page only
#   pages : redesign every HTML file independently
#   site  : redesign every HTML file, sharing one site context between them
# entry selection order: input.entry, then index.html, input.html, the largest HTML.
# Files and folders starting with "_" or "." are ignored.
input:
  directory: "input"
  mode: "entry"
  entry: null
  asset_directory: "assets"
  # Upper bound on the source CSS/JS read for the style and script digests.
  # The source text is never sent to a model; only the distilled digest is.
  max_css_bytes: 512000
  max_js_bytes: 512000
  vision:
    enabled: true
    # Images below either threshold are skipped (favicons, sprite icons).
    min_bytes: 4096
    min_dimension: 64
    max_images: 20
    # Render the source page and read its overall impression. Needs Playwright.
    screenshot: true
    # Scroll-reveal animations start at opacity 0, so an untouched screenshot is
    # mostly blank. Scroll the page first, then force whatever is still
    # transparent into view.
    reveal_animations: true
    # Images analysed at once. Raise this only if the Ollama server actually has
    # more than one parallel slot (OLLAMA_NUM_PARALLEL); otherwise the requests
    # queue and nothing is gained.
    concurrency: 1
    # Keyed by file content, so re-running the same input costs no vision calls.
    cache_directory: ".cache/vision"

# Building a site from a brief instead of redesigning one. This runs when input/
# holds no HTML but does hold a .md/.txt/.yaml brief; content freedom is forced
# to madmax there, because there is no source to preserve.
creator:
  max_pages: 4

design:
  mode: "auto"
  presets:
    - "business"
    - "portfolio"
    - "blog"
    - "landing"
    - "ecommerce"

# How far the pipeline may depart from the source content.
#   low    : keep the source content as-is
#   medium : minor additions/deletions/rewording, meaning preserved
#   high   : rewrite, drop, and add content on the source basis
#   ultra  : free authoring; source content is reference material
#   madmax : the page is written from scratch for the subject; only its
#            identity and factual record are fixed
# low and medium require every populated content collection to be placed.
# Dates, numbers, names, and their pairings must stay accurate at every level.
content:
  freedom: "low"

evaluation:
  model:
    - name: "gemma4:26b"
      think: false
      timeout: 600

browser:
  enabled: false
  timeout_ms: 10000
  screenshot: true
  viewports:
    - name: desktop
      width: 1440
      height: 900
    - name: tablet
      width: 768
      height: 1024
    - name: mobile
      width: 390
      height: 844

frameworks:
  css:
    - name: "Bootstrap"
      cdn: "https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      tag: "link"
    - name: "TailwindCSS"
      cdn: "https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"
      tag: "script"
    - name: "Bulma"
      cdn: "https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css"
      tag: "link"
    - name: "Foundation"
      cdn: "https://cdn.jsdelivr.net/npm/foundation-sites@6.9.0/dist/css/foundation.min.css"
      tag: "link"
    - name: "Materialize"
      cdn: "https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css"
      tag: "link"
  js:
    - name: "GSAP"
      cdn: "https://cdn.jsdelivr.net/npm/gsap@3.15/dist/gsap.min.js"
      tag: "script"
    - name: "Svelte"
      cdn: "https://cdn.jsdelivr.net/npm/svelte@5.57.0/+esm"
      tag: "script"
    - name: "React"
      cdn: "https://unpkg.com/react@18/umd/react.production.min.js"
      tag: "script"
    - name: "ReactDOM"
      cdn: "https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"
      tag: "script"
    - name: "Vue"
      cdn: "https://unpkg.com/vue@3/dist/vue.global.js"
      tag: "script"
    - name: "Angular"
      cdn: "https://cdnjs.cloudflare.com/ajax/libs/angular.js/1.8.3/angular.min.js"
      tag: "script"

pipeline:
  max_iterations: 3
  evaluation_threshold: 8.0
  # Disabled, every page keeps being iterated until you interrupt the run.
  termination:
    enabled: true
    # 최고 점수가 이만큼의 회차 동안 갱신되지 않으면 그 페이지를 마친다.
    # 0이면 max_iterations만으로 제한한다. enabled가 false면 무시된다.
    patience: 2
  # 2회차부터 디자인을 새로 세우는 대신 최고 결과를 국소 수정한다.
  # 전체 재생성은 잘 나온 부분까지 버리므로 후퇴가 잦다.
  refine:
    enabled: false
    # 국소 수정이 이만큼 연속으로 개선에 실패하면 한 번은 전체 재설계로 돌아간다.
    # 0이면 절대 돌아가지 않아, 막힌 페이지가 막힌 채로 남는다.
    redesign_after_stalls: 2
    # 한 번의 수정이 겨냥하는 최저점 항목 수.
    weakest_dimensions: 3
  output:
    save_mode: "all"

recovery:
  max_retries: 3
  initial_num_ctx: 8192
  # Upper bound on the *initial* estimate. This is the VRAM guard: a larger
  # window means a larger KV cache. Recovery escalates beyond it up to
  # max_num_ctx.
  initial_ceiling_num_ctx: 32768
  max_num_ctx: 131072
  # Shape of the retry escalation from the initial window to max_num_ctx. The
  # final attempt always lands on max_num_ctx; growth_power decides how much of
  # the growth is deferred to it. Above 1.0 keeps the early retries small and
  # cheap, 1.0 is linear, below 1.0 jumps large immediately.
  growth_power: 2.0
  # The designer's revision prompt carries the previous spec, an HTML
  # excerpt and the evaluation on top of the Feature Model, and its own
  # DesignSpec output runs long, so it needs more room than a first plan.
  designer_output_headroom_tokens: 8192
  # The generator emits a whole HTML document, so its context estimate must
  # reserve far more output room than the JSON-producing roles.
  generator_output_headroom_tokens: 16384

logging:
  level: "INFO"
  console_level: "INFO"
  directory: "log"

viewer:
  # Result viewer server (show-pages)
  host: "0.0.0.0"
  port: 5002
  debug: true
  output_root: "output"
  # Score badge thresholds (out of 10)
  score_high_threshold: 8.0
  score_mid_threshold: 6.0
