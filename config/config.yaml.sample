ollama:
  base_url: "http://localhost:11434"

# Multiple models may be configured for each role.
# Each entry may be a model name string or an object with per-model options.
# think: true/false enables/disables Ollama reasoning when supported by the model.
# timeout: request timeout in seconds. Omit it to use the Ollama client default.
models:
  analyzer:
    - name: "gemma4:26b"
      think: false
      timeout: 600
  designer:
    - name: "gemma4:26b"
      think: true
      timeout: 600
  generator:
    - name: "gemma4:26b"
      think: false
      timeout: 600

design:
  mode: "auto"
  presets:
    - "business"
    - "portfolio"
    - "blog"
    - "landing"
    - "ecommerce"

evaluation:
  model:
    - name: "gemma4:26b"
      think: false
      timeout: 600

browser:
  enabled: false
  timeout_ms: 10000
  screenshot: true
  viewports:
    - name: desktop
      width: 1440
      height: 900
    - name: tablet
      width: 768
      height: 1024
    - name: mobile
      width: 390
      height: 844

frameworks:
  css:
    - name: "Bootstrap"
      cdn: "https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      tag: "link"
    - name: "TailwindCSS"
      cdn: "https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"
      tag: "script"
    - name: "Bulma"
      cdn: "https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css"
      tag: "link"
    - name: "Foundation"
      cdn: "https://cdn.jsdelivr.net/npm/foundation-sites@6.9.0/dist/css/foundation.min.css"
      tag: "link"
    - name: "Materialize"
      cdn: "https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css"
      tag: "link"
  js:
    - name: "GSAP"
      cdn: "https://cdn.jsdelivr.net/npm/gsap@3.15/dist/gsap.min.js"
      tag: "script"
    - name: "Svelte"
      cdn: "https://cdn.jsdelivr.net/npm/svelte@5.57.0/+esm"
      tag: "script"
    - name: "React"
      cdn: "https://unpkg.com/react@18/umd/react.production.min.js"
      tag: "script"
    - name: "ReactDOM"
      cdn: "https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"
      tag: "script"
    - name: "Vue"
      cdn: "https://unpkg.com/vue@3/dist/vue.global.js"
      tag: "script"
    - name: "Angular"
      cdn: "https://cdnjs.cloudflare.com/ajax/libs/angular.js/1.8.3/angular.min.js"
      tag: "script"

pipeline:
  max_iterations: 3
  evaluation_threshold: 8.0
  termination:
    enabled: true
  output:
    save_mode: "all"

recovery:
  max_retries: 3
  initial_num_ctx: 8192
  max_num_ctx: 32768
  context_multiplier: 2.0

logging:
  level: "INFO"
  console_level: "INFO"
  directory: "log"
