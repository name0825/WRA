ollama:
  base_url: "http://localhost:11434"

# Multiple models may be configured for each role.
# Each entry may be a model name string or an object with per-model options.
# think: true/false enables/disables Ollama reasoning when supported by the model.
# timeout: request timeout in seconds. Omit it to use the Ollama client default.
models:
  analyzer:
    - name: "gemma4:26b"
      think: false
      timeout: 600
  designer:
    - name: "gemma4:26b"
      think: true
      timeout: 600
  generator:
    - name: "gemma4:26b"
      think: false
      timeout: 600

design:
  # auto: infer the page type from the FeatureModel.
  # Otherwise, the value must be one of the configured presets below.
  mode: "auto"
  presets:
    - "business"
    - "portfolio"
    - "blog"
    - "landing"
    - "ecommerce"

evaluation:
  model:
    - name: "gemma4:26b"
      think: false
      timeout: 600

browser:
  enabled: false
  timeout_ms: 10000
  screenshot: true
  viewports:
    - name: desktop
      width: 1440
      height: 900
    - name: tablet
      width: 768
      height: 1024
    - name: mobile
      width: 390
      height: 844

frameworks:
  css: []
  js: []

pipeline:
  max_iterations: 3
  evaluation_threshold: 8.0

  termination:
    enabled: true

  output:
    save_mode: "all"

recovery:
  max_retries: 3
  initial_num_ctx: 8192
  max_num_ctx: 32768
  context_multiplier: 2.0

logging:
  level: "INFO"
  console_level: "INFO"
  directory: "log"
