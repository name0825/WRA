ollama:
  base_url: "http://localhost:11434"

models: {}

evaluation:
  model: ""

frameworks:
  css: []
  js: []

pipeline:
  max_iterations: 3
  evaluation_threshold: 8.0

  termination:
    enabled: true

  output:
    save_mode: "all"

recovery:
  max_retries: 3
  initial_num_ctx: 8192
  max_num_ctx: 32768
  context_multiplier: 2.0
