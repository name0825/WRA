ollama:
  base_url: "http://localhost:11434"

# Multiple models may be configured for each role.
# One model is selected randomly at the beginning of each iteration.
models:
  analyzer: []
  designer: []
  generator: []

design:
  # auto: infer the page type from the FeatureModel.
  # Otherwise, the value must be one of the configured presets below.
  mode: "auto"
  presets:
    - "business"
    - "portfolio"
    - "blog"
    - "landing"
    - "ecommerce"

evaluation:
  model: []

browser:
  enabled: false
  timeout_ms: 10000
  screenshot: true
  viewports:
    - name: desktop
      width: 1440
      height: 900
    - name: tablet
      width: 768
      height: 1024
    - name: mobile
      width: 390
      height: 844

frameworks:
  css: []
  js: []

pipeline:
  max_iterations: 3
  evaluation_threshold: 8.0

  termination:
    enabled: true

  output:
    save_mode: "all"

recovery:
  max_retries: 3
  initial_num_ctx: 8192
  max_num_ctx: 32768
  context_multiplier: 2.0
